# このファイルを .env にコピーして使ってください（未作成でも動作します）。
# ログイン不要なシステムのため、認証情報の設定は不要です（KOUEN-MONITOR.md 2節参照）。

# 何週間先まで確認するか（省略時は1 = 直近7日分のみ）
WEEKS_AHEAD=1

# --- 土日祝の新規空きメール通知（monitor.js）---
# resend.com で無料取得できるAPI Key。未設定の場合は通知をスキップするだけで、
# 通常の監視・スナップショット保存は問題なく続行される。
RESEND_API_KEY=

# 通知の送信先。省略時は songqintai169@gmail.com 宛て
# ALERT_MAIL_TO=

# 送信元表示名。省略時は「都立公園空き状況監視 <onboarding@resend.dev>」
# （自分のドメインを検証していない場合、fromはonboarding@resend.dev固定になる）
# MAIL_FROM=
